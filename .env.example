# ============================================================
# AudioGraphy environment configuration (copy to .env and edit)
# ============================================================

# --- Adapter mode -------------------------------------------------------
# mock : all adapters return deterministic fake data, no external deps (default)
# real : call actual vLLM / funASR / bge-m3 / Silero VAD services (requires GPU)
ADAPTER_MODE=mock

# --- Per-adapter mode (override ADAPTER_MODE for individual adapters) ---
# M4: per-adapter fields are the SOLE source of truth for mock/real resolution.
# Default "mock" preserves M3 all-mock behavior. Legacy ADAPTER_MODE above is
# retained only for back-compat and does NOT auto-propagate to these fields.
ADAPTER_ASR_MODE=mock               # M5: set to real for funASR OpenAI-compat API
ADAPTER_VAD_MODE=mock               # set to real for Silero VAD
ADAPTER_LLM_MODE=mock               # set to real for vLLM (strong+weak share mode)
ADAPTER_EMBED_MODE=mock             # set to real for bge-m3

# --- Real-mode endpoints ---
SILERO_VAD_URL=http://silero-vad:8002
BGE_M3_URL=http://bge-m3:8080
HF_TOKEN=                           # required for gated Qwen models on HuggingFace

# --- Database (MySQL 8) -------------------------------------------------
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=audiography
MYSQL_PASSWORD=change-me
MYSQL_DB=audiography
MYSQL_ROOT_PASSWORD=root

# --- LLM (only used when ADAPTER_MODE=real) ----------------------------
OPENAI_BASE_URL_STRONG=http://vllm-strong:8000/v1
OPENAI_BASE_URL_WEAK=http://vllm-weak:8001/v1
OPENAI_API_KEY=dummy
LLM_STRONG_MODEL=qwen3.6-27b
LLM_WEAK_MODEL=qwen3.6-35b-a3b

# --- ASR / VAD / Embedding (only used when ADAPTER_*_MODE=real) ----------
FUNASR_URL=http://funasr:8000       # OpenAI-compat endpoint (M5+)
FUNASR_MODEL=fun-asr-nano           # must match funasr-server --served-model-name
FUNASR_DEVICE=cpu                   # cpu works for fun-asr-nano; cuda for fun-asr-large
SILERO_VAD_URL=http://silero-vad:8002
BGE_M3_URL=http://bge-m3:8080
EMBEDDING_DIM=1024

# --- Storage ------------------------------------------------------------
WORKING_DIR=/data/working_dir

# --- Multi-tenancy ------------------------------------------------------
DEFAULT_TENANT_ID=default

# --- Auth (JWT) ---------------------------------------------------------
JWT_SECRET=change-me-to-32-char-random-please
JWT_EXP_HOURS=12
JWT_ALGORITHM=HS256

# --- Pipeline (APScheduler) --------------------------------------------
PIPELINE_POLL_SECONDS=5
PIPELINE_CONCURRENCY=1

# --- Retention ----------------------------------------------------------
RECORDING_RETENTION_DAYS=90

# --- Feature flags ------------------------------------------------------
ENABLE_CLAP=false
ENABLE_VOICEPRINT=false

# --- Mock flakiness (testing only) -------------------------------------
MOCK_ASR_FLAKY=false
MOCK_LLM_ERROR_RATE=0.005

# --- Logging ------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- CORS (frontend origin) --------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Eval subsystem ----------------------------------------------------
JUDGE_LLM_MODEL=                    # empty = use LLM_STRONG_MODEL; set to override
EVAL_CONCURRENCY=4                  # parallel examples during evaluation
