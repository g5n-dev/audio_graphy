# ============================================================
# AudioGraphy .env.example — mirrors backend/audio_graphy/config.py
# ============================================================
# Copy this file to .env and edit values. The repo ships all-mock by
# default; select one of mock / models-cpu / models-single-gpu /
# models-multi-gpu and enable only adapters present in that profile.
#
# Tips:
#   - All field names match config.py (case-insensitive).
#   - Optional fields are commented out with sensible defaults shown.
#   - M6 PIPL fields are required only for production deployment.
# ============================================================

# --- Adapter mode (M3 back-compat + M4 per-adapter) -----------
# Legacy global default (retained for M3 .env back-compat). Does NOT drive
# mode resolution — set the per-adapter fields below instead.
ADAPTER_MODE=mock
# Per-adapter modes (SOLE source of truth, M4+). Set to "real" for docker
# compose --profile models-cpu|models-single-gpu|models-multi-gpu.
ADAPTER_ASR_MODE=mock
ADAPTER_VAD_MODE=mock
ADAPTER_LLM_MODE=mock
ADAPTER_EMBED_MODE=mock
ADAPTER_AUDIO_EMBED_MODE=mock
ADAPTER_VOICEPRINT_MODE=mock

# --- Compose host publishing ----------------------------------
# All published ports bind to loopback by default. APP controls only the
# frontend/backend; PRIVATE controls MySQL, Adminer, and every model API.
COMPOSE_APP_BIND_HOST=127.0.0.1
COMPOSE_PRIVATE_BIND_HOST=127.0.0.1
MYSQL_HOST_PORT=3307
ADMINER_HOST_PORT=8081
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=5173

# --- Database (MySQL 8) ---------------------------------------
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=audiography
MYSQL_PASSWORD=change-me
MYSQL_DB=audiography
MYSQL_ROOT_PASSWORD=root

# --- LLM (only used when ADAPTER_LLM_MODE=real) ---------------
# --- No-GPU alternative -----------------------------------------
# vLLM images are CUDA-only. On an arm64 Mac or any GPU-less host, run
# Ollama instead — it serves the same OpenAI-compatible contract:
#   OPENAI_BASE_URL_STRONG=http://host.docker.internal:11434/v1
#   OPENAI_BASE_URL_WEAK=http://host.docker.internal:11434/v1
#   LLM_STRONG_MODEL=qwen2.5:7b
#   LLM_WEAK_MODEL=qwen2.5:7b
#   OPENAI_API_KEY=ollama
# Keep LLM_*_STRUCTURED_OUTPUT_CAPABILITY at strict_json_schema even though
# Ollama does not implement it. Measured: the adapter detects that, falls
# back to json_object, and still returns schema-conforming keys — while
# configuring json_object directly does not, and the model invents key
# names (asked for "n", returned "number").
OPENAI_BASE_URL_STRONG=http://vllm-strong:8000/v1
OPENAI_BASE_URL_WEAK=http://vllm-weak:8000/v1
OPENAI_API_KEY=dummy
LLM_STRONG_MODEL=qwen3.6-27b
LLM_WEAK_MODEL=qwen3.6-35b-a3b
# Bump when weights/tokenizer change without changing the served model name.
# Empty defaults to the corresponding exact model string.
LLM_STRONG_MODEL_EPOCH=
LLM_WEAK_MODEL_EPOCH=
# Provider capability is explicit and checked before business traffic.
# Values: strict_json_schema | json_object | unsupported
LLM_STRONG_STRUCTURED_OUTPUT_CAPABILITY=strict_json_schema
LLM_WEAK_STRUCTURED_OUTPUT_CAPABILITY=strict_json_schema
# Optional immutable provider price card. Configure all seven values together.
# Rates are micro-currency-units per 1,000,000 tokens (for example 2000000 = 2
# currency units per million tokens). Leave all unset to disable cost budgeting.
# LLM_PRICE_VERSION=provider-price-2026-07
# LLM_STRONG_INPUT_MICROUNITS_PER_MILLION_TOKENS=2000000
# LLM_STRONG_OUTPUT_MICROUNITS_PER_MILLION_TOKENS=8000000
# LLM_STRONG_CACHED_PREFILL_MICROUNITS_PER_MILLION_TOKENS=500000
# LLM_WEAK_INPUT_MICROUNITS_PER_MILLION_TOKENS=500000
# LLM_WEAK_OUTPUT_MICROUNITS_PER_MILLION_TOKENS=2000000
# LLM_WEAK_CACHED_PREFILL_MICROUNITS_PER_MILLION_TOKENS=125000

# --- LLM multi-level cache ------------------------------------
# auto: use Redis only when REDIS_URL is configured and healthy; otherwise
# use the bounded process-local cache. MySQL remains the durable source.
LLM_HOT_CACHE_BACKEND=auto
# Set when using an external Redis or the optional Compose cache-redis profile:
# REDIS_URL=redis://redis:6379/0
LLM_LOCAL_CACHE_MAX_ENTRIES=1024
LLM_LOCAL_CACHE_MAX_BYTES=33554432
LLM_HOT_CACHE_MAX_ITEM_BYTES=1048576
LLM_LOCAL_CACHE_TTL_SECONDS=300
LLM_REDIS_CACHE_TTL_SECONDS=3600
LLM_REDIS_FAILURE_THRESHOLD=3
LLM_REDIS_CIRCUIT_SECONDS=30
LLM_REDIS_RECOVERY_SUCCESSES=2
LLM_REDIS_PROBE_SECONDS=5
LLM_CACHE_LEASE_SECONDS=120
LLM_CACHE_CLEANUP_INTERVAL_SECONDS=3600
LLM_CACHE_CLEANUP_BATCH_SIZE=500
LLM_CACHE_MAX_ENTRIES_PER_TENANT=50000
LLM_CACHE_MAX_BYTES_PER_TENANT=268435456
LLM_CACHE_MAX_PAYLOAD_BYTES=16777216
# Generation-key migration: shadow (v1 authoritative + v2 backfill), then
# dual_read (v2 first + v1 promotion), finally v2.
LLM_RECIPE_MIGRATION_MODE=shadow
# Deprecated compatibility switch; omit when migration mode is configured.
# LLM_RECIPE_SHADOW_MODE=false
# Independent rollout/rollback switches. Exact persistent caching defaults on.
ENABLE_LLM_EXACT_CACHE=true
ENABLE_LLM_HOT_CACHE=true
ENABLE_LLM_PERSISTENT_CACHE=true
ENABLE_LLM_SEMANTIC_CACHE=false
ENABLE_LLM_BATCH_JUDGE=false
ENABLE_HYBRID_RULE_SHORT_CIRCUIT=true
ENABLE_ADAPTIVE_GLEANING=false
LLM_STRONG_CONCURRENCY=4
LLM_WEAK_CONCURRENCY=8

# --- ASR / VAD / Embedding (real mode only) -------------------
# The `funasr` compose service is now a self-built Paraformer container
# (docker/paraformer-service/) rather than the image `funasr/server:1.0.5`,
# which does not exist on Docker Hub. The HTTP contract is unchanged.
FUNASR_URL=http://funasr:8000
# Served-model label only. The service hosts one pipeline and echoes whatever
# name it is sent, so this value is free-form and kept for backward
# compatibility. The pipeline is selected by PARAFORMER_*_MODEL below.
FUNASR_MODEL=fun-asr-nano
FUNASR_LANGUAGE=zh
# ModelScope ids for the ASR pipeline. Defaults are funasr's own `paraformer-zh`
# recipe. SeACo-Paraformer is required for sentence timestamps — the plain
# `speech_paraformer-large_asr_nat-*` checkpoint cannot predict them.
PARAFORMER_ASR_MODEL=iic/speech_seaco_paraformer_large_asr_nat-zh-cn-16k-common-vocab8404-pytorch
PARAFORMER_VAD_MODEL=iic/speech_fsmn_vad_zh-cn-16k-common-pytorch
PARAFORMER_PUNC_MODEL=iic/punc_ct-transformer_cn-en-common-vocab471067-large
# First boot downloads ~2 GB from ModelScope (990 MB ASR + ~1.1 GB punctuation).
# On a slow link, or where disk is tight, the Chinese-only punctuation model is
# roughly a quarter the size — at the cost of worse handling of CN/EN mixed
# speech, which meeting audio full of English product names does contain:
#   PARAFORMER_PUNC_MODEL=iic/punc_ct-transformer_zh-cn-common-vocab272727-pytorch
# Setting it empty disables punctuation entirely. Measured consequence: funasr
# then skips sentence segmentation, so every response is a single segment
# covering the whole file. Transcription stays character-accurate, but the
# per-sentence timeline disappears — do not do this if anything downstream
# aligns speakers or tags to time ranges.
# On Docker Desktop these land in a named volume inside the fixed-size Docker
# VM disk, not on the host filesystem. Check `docker system df` has room before
# first boot: an exhausted VM disk surfaces only as repeated ModelScope
# "[Errno 28] No space left on device" retries in the container log.
# No unverified batch-VAD image is bundled. Keep ADAPTER_VAD_MODE=mock unless
# this points to an audited /v1/vad/segment-compatible external service.
SILERO_VAD_URL=http://silero-vad.invalid:8000
BGE_M3_URL=http://bge-m3:80
CLAP_SERVICE_URL=http://clap-service:8006
CAMPPLUS_SERVICE_URL=http://campplus-service:8007
EMBEDDING_DIM=1024

# --- Compose model topology -----------------------------------
# Explicit host GPU IDs; every GPU service reserves exactly one device.
VLLM_STRONG_GPU_ID=0
VLLM_WEAK_GPU_ID=1
BGE_M3_GPU_ID=0
CLAP_GPU_ID=0
VLLM_STRONG_GPU_MEMORY_UTILIZATION=0.72
VLLM_WEAK_GPU_MEMORY_UTILIZATION=0.82

# Model diagnostic ports. COMPOSE_PRIVATE_BIND_HOST keeps them loopback-only.
# Container-to-container URLs above must use service ports.
VLLM_STRONG_HOST_PORT=18000
VLLM_WEAK_HOST_PORT=18001
BGE_M3_HOST_PORT=18080
FUNASR_HOST_PORT=10095
CLAP_HOST_PORT=18006
CAMPPLUS_HOST_PORT=18007

# --- BGE-M3 / TEI on arm64 ------------------------------------
# Upstream publishes TEI's CPU builds per architecture under different tags:
# the versioned `cpu-<ver>` tags are amd64-only. On an arm64 host (Apple
# Silicon, Graviton) leaving this unset means compose runs the amd64 image
# under emulation — it does work, but ~13x slower per request. Uncomment on
# arm64; leave commented on amd64.
# BGE_M3_CPU_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-arm64-sha-4150561

# TEI sizes its ONNX-Runtime arenas from --max-batch-tokens, and bge-m3 is
# XLM-R-large, so memory grows quadratically in that number. Measured (arm64,
# BAAI/bge-m3, --max-client-batch-size 64):
#   8192 -> 13.79 GiB resident, batch-of-64 in 2.74s
#   4096 ->  6.40 GiB resident, batch-of-64 in 2.12s
#   2048 ->  4.82 GiB resident, batch-of-64 in 2.71s
# The extra 9 GiB at 8192 buys no throughput and is what gets bge-m3 OOM-killed
# (exit 137) when it shares a 32 GiB host with funASR and CAM++. 4096 keeps 3.4x
# headroom over the largest text the app sends — Chunker(token_budget=1200)
# measures 877 XLM-R tokens on Chinese. Raise it only if you also raise the
# chunker budget, and re-measure memory when you do.
BGE_M3_MAX_BATCH_TOKENS=4096

# bge-m3's ONNX weights are ~2.3GB and TEI's own downloader cannot resume, so
# the `bge-m3-cache-init` one-shot service pre-fills the tei_cache volume with
# huggingface_hub before TEI starts. Point it at a mirror if huggingface.co is
# slow or blocked; raise the timeout on a lossy link.
# HF_ENDPOINT=https://hf-mirror.com
# HF_HUB_DOWNLOAD_TIMEOUT=60

# BGE-M3 (TEI) container image for the `models-cpu` profile. The versioned
# `cpu-<version>` tags upstream publishes are amd64-only; on an arm64 host
# (Apple Silicon, Graviton) leaving the default forces x86 emulation, which
# measured ~13x slower per request on an M3 Max. Uncomment the arm64 build —
# upstream only tags it as `cpu-arm64-latest` / `cpu-arm64-sha-<rev>`:
# BGE_M3_CPU_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-arm64-sha-4150561
#
# Must stay >= BGEEmbedAdapter's per-call cap (64); TEI's own default is 32 and
# it rejects anything larger with HTTP 422.
BGE_M3_MAX_CLIENT_BATCH_SIZE=64
# Health-check grace period. The first start pulls ~2.3GB of weights into the
# tei_cache volume before the HTTP port opens.
BGE_M3_START_PERIOD=1800s

# --- Eval subsystem (M5 + M6) ---------------------------------
# Empty → fallback to LLM_STRONG_MODEL.
JUDGE_LLM_MODEL=
EVAL_CONCURRENCY=4
# M6: position de-bias — run judge twice (orig + reversed context).
EVAL_POSITION_DEBIAS=true

# --- Storage --------------------------------------------------
WORKING_DIR=/data/working_dir
# Normalized vector indexes: bounded hot cache + streamed cold-load budgets.
VECTOR_INDEX_CACHE_TTL_SECONDS=60
VECTOR_INDEX_CACHE_MAX_ENTRIES=32
VECTOR_INDEX_CACHE_MAX_BYTES=536870912
VECTOR_INDEX_LOAD_BATCH_ROWS=512
VECTOR_INDEX_LOAD_MAX_ROWS=100000
VECTOR_INDEX_LOAD_MAX_SOURCE_BYTES=536870912
VECTOR_INDEX_LOAD_MAX_MEMORY_BYTES=536870912
# Maximum number of tenant NetworkX graphs retained in one backend process.
GRAPH_STORE_CACHE_MAX_ENTRIES=64
# Hard server-side response budget for induced edges in graph explore/subgraph.
# Clients may request a lower edge_limit; values above 5000 are rejected.
GRAPH_EDGE_RENDER_BUDGET=5000

# --- Multi-tenancy --------------------------------------------
DEFAULT_TENANT_ID=default

# --- Auth (JWT) -----------------------------------------------
# Must be ≥ 16 chars; required to be a strong secret when any ADAPTER_*_MODE=real.
JWT_SECRET=change-me-to-32-char-random-please
JWT_EXP_HOURS=12
JWT_REFRESH_EXP_HOURS=84
JWT_ALGORITHM=HS256

# --- Password hashing -----------------------------------------
BCRYPT_ROUNDS=12

# --- Pipeline (APScheduler) -----------------------------------
PIPELINE_POLL_SECONDS=5
PIPELINE_CONCURRENCY=1

# --- Retention ------------------------------------------------
# Recordings older than this are hard-deleted by the daily 03:00 cron.
RECORDING_RETENTION_DAYS=90

# --- PIPL §14.3 (M6) — audio encryption -----------------------
# Path to the 32-byte urlsafe-base64 master key file (chmod 0600).
# Compose initializes this file once in a dedicated volume and mounts it
# read-only. Non-Compose deployments must provision it out-of-band. Startup
# fails closed when the key is missing or malformed (DEBUG is local-only).
MASTER_KEY_PATH=/run/secrets/audiography_master.key
# Hard upper bound for one registered recording (512 MiB).
MAX_RECORDING_AUDIO_BYTES=536870912
# Authenticated streaming-encryption chunk size (4 MiB; range 1 KiB–16 MiB).
AUDIO_CRYPTO_CHUNK_SIZE_BYTES=4194304
# Global HTTP request-body cap. Audio streaming uses WebSocket and is not
# buffered here; JSON insight imports are rejected above 16 MiB.
MAX_REQUEST_BODY_BYTES=16777216

# --- Physical reception audio assembly -----------------------
AUDIO_ASSEMBLY_MAX_SOURCES=128
AUDIO_ASSEMBLY_MAX_TOTAL_BYTES=2147483648
AUDIO_ASSEMBLY_MAX_ESTIMATED_PCM_BYTES=2147483648
AUDIO_ASSEMBLY_MAX_TEMPORARY_BYTES=2147483648
AUDIO_ASSEMBLY_FFPROBE_TIMEOUT_SEC=30
AUDIO_ASSEMBLY_FFMPEG_TIMEOUT_SEC=900
AUDIO_ASSEMBLY_MAX_PROCESSES=2

# --- Entity fuzzy matching (M6 WS-3) --------------------------
# rapidfuzz fuzz.WRatio threshold for clustering near-duplicate entity
# names. 0.85 default balances precision and recall.
#   0.80 = loose (max recall, may over-merge)
#   0.85 = default (recommended)
#   0.90 = strict (max precision)
ENTITY_FUZZY_THRESHOLD=0.85

# --- Feature flags --------------------------------------------
ENABLE_CLAP=false
# Speaker linking (ADR-0001). Off by default, and only safe to enable together
# with ADAPTER_VOICEPRINT_MODE=real above: the mock adapter derives vectors from
# the diarization label, so the same label in two unrelated recordings matches
# above the merge threshold and distinct speakers are linked into one identity
# without review — then stored as encrypted biometric data. Enabling it on mock
# logs a warning at startup.
# After turning it on for an existing tenant, run
# scripts/backfill_voiceprints.py — the flag only affects new recordings.
ENABLE_VOICEPRINT=false
ENABLE_STREAMING=false
# Production must use the single-use /ws/tickets exchange. Set true only for a
# short emergency rollback window while legacy clients are being upgraded.
STREAMING_ALLOW_LEGACY_JWT_QUERY=false

# --- M9 advanced graph (R1 + R2) ------------------------------
# Master switch (L9). When false, EVERY M9 R2 router (bi-temporal,
# Leiden admin, search, compression admin) is omitted from the app
# and the paths return 404. R1 services (bi-temporal core, Leiden
# core, compression core) always load; only the HTTP surface is gated.
ENABLE_ADVANCED_GRAPH=false
# Sub-flags (ignored when ENABLE_ADVANCED_GRAPH=false):
ENABLE_BITEMPORAL_EDGES=true
ENABLE_LEIDEN=true
ENABLE_COMPRESSION=true
ENABLE_SPEAKER_LAYER2_FUZZY=true
# Leiden tuning:
LEIDEN_THRESHOLD_PERCENT=30.0
LEIDEN_LIB=networkx   # one of: leidenalg | networkx | fail-fast
LEIDEN_MAX_LEVELS=2
# Community summary strategy (Q2): eager | lazy | disabled
COMMUNITY_SUMMARY_STRATEGY=eager
# Compression tuning (Q3 SOFT-only):
COMPRESSION_GOD_NODE_DEGREE=50
COMPRESSION_STALE_DAYS=180
COMPRESSION_MAX_CANDIDATES_PER_RUN=100
# L8 speaker fuzzy thresholds:
SPEAKER_FUZZY_AMBIGUOUS_THRESHOLD=0.85
SPEAKER_FUZZY_INFERRED_THRESHOLD=0.6
SPEAKER_FUZZY_VOICEPRINT_RECONFIRM_COSINE=0.7

# --- Mock flakiness (testing) ---------------------------------
MOCK_ASR_FLAKY=false
MOCK_LLM_ERROR_RATE=0.005

# --- Logging --------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- CORS -----------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ==============================================================
# Streaming capture (ENABLE_STREAMING=true)
# ==============================================================
# The ws_stream router is not registered unless ENABLE_STREAMING is on, so
# every value below is inert by default.
ADAPTER_STREAMING_VAD_MODE=mock
ADAPTER_STREAMING_ASR_MODE=mock
FUNASR_WS_URL=ws://funasr:10095
# Path inside the container. docker-compose.streaming-vad.yml bind-mounts the
# ONNX model here; the file is not bundled with the repository.
SILERO_VAD_MODEL_PATH=/models/silero_vad.onnx
# Path on the HOST to that ONNX file, read by the streaming-vad overlay's bind
# mount. Not a Settings field — compose reads it directly, which is why it never
# appeared in this file. Its default (./models/silero_vad.onnx) does not exist in
# a fresh clone: download the model first, or point this at wherever you keep it.
# `docker compose config` does not stat bind sources, so a wrong value here is
# only discovered at `up`, as a mount failure rather than a missing model.
#   curl -Lo models/silero_vad.onnx \
#     https://github.com/snakers4/silero-vad/raw/master/src/silero_vad/data/silero_vad.onnx
SILERO_VAD_MODEL_FILE=./models/silero_vad.onnx

# Session lifecycle
STREAMING_SESSION_TIMEOUT_SEC=300.0
STREAMING_SESSION_PCM_BUFFER_MAX_SEC=60.0
STREAMING_WS_TICKET_TTL_SEC=60

# Upstream ASR connection pool — per tenant, so N backend replicas hold N x this
STREAMING_ASR_POOL_SIZE_PER_TENANT=8
STREAMING_ASR_CHUNK_INTERVAL=10
STREAMING_ASR_CONNECT_TIMEOUT_SEC=5.0
STREAMING_ASR_PUSH_TIMEOUT_SEC=30.0
STREAMING_ASR_FINALIZE_TIMEOUT_SEC=5.0

# Voice-activity thresholds. Onset must stay above offset (hysteresis).
STREAMING_VAD_ONSET_THRESHOLD=0.5
STREAMING_VAD_OFFSET_THRESHOLD=0.35
STREAMING_VAD_MIN_SPEECH_SEC=0.25
STREAMING_VAD_MIN_SILENCE_SEC=0.10
STREAMING_VAD_CHUNK_SAMPLES=512
STREAMING_VAD_RESET_SEQ_GAP=3

# Incremental tagging while a session is live
STREAMING_TAG_INTERVAL=5
STREAMING_TAG_DEBOUNCE_MS=500.0
ENABLE_STREAMING_RETRIEVAL=false
STREAMING_INFERRED_EDGE_WEIGHT=0.8
STREAMING_AMBIGUOUS_EDGE_WEIGHT=0.5

# WebSocket transport
WS_JWT_TTL_MINUTES=5
WS_HEARTBEAT_INTERVAL_SEC=30.0
WS_MAX_RECV_QUEUE=200
WS_BACKPRESSURE_WARN=100

# ==============================================================
# Voiceprint (ENABLE_VOICEPRINT=true)
# ==============================================================
VOICEPRINT_COSINE_THRESHOLD=0.5
VOICEPRINT_AMBIGUOUS_THRESHOLD=0.7
# Sampling strategy and quality gates — ADR-0001 (docs/adr/0001-voiceprint-sampling.md).
# weighted_mean averages several qualifying segments; longest_segment uses only the
# longest one, which is cheaper and noisier.
VOICEPRINT_SAMPLING_STRATEGY=weighted_mean
# A segment shorter than this contributes no embedding, and a speaker with less
# total qualifying speech than MIN_TOTAL_SEC is skipped rather than sampled badly.
# MIN_SEGMENT_SEC > MIN_TOTAL_SEC is a startup-fatal ValueError — no speaker could
# ever clear the total gate.
VOICEPRINT_SAMPLE_MIN_SEGMENT_SEC=1.0
VOICEPRINT_SAMPLE_MIN_TOTAL_SEC=3.0
VOICEPRINT_SAMPLE_MAX_SEGMENTS=8
# Drop a segment whose embedding sits below this cosine to the speaker's mean.
# 0.0 disables outlier rejection.
VOICEPRINT_SAMPLE_OUTLIER_COSINE=0.5
# Delete stored voiceprints alongside their recording (PIPL erasure).
VOICEPRINT_RETENTION_CASCADE=true
CAMPPLUS_PREFER_GPU=false
CLAP_FORCE_GPU=true

# ==============================================================
# LLM cost accounting
# ==============================================================
# Micro-units per million tokens; used for per-call cost attribution only, it
# does not gate anything. Attribution is off here, which means the version stays
# empty AND all six rates stay unset — `=0` is a configured rate, not an unset
# one, and the all-or-none validator rejects that pairing at startup. Uncomment
# all seven together to turn attribution on.
LLM_PRICE_VERSION=
# LLM_PRICE_VERSION=provider-price-2026-07
# LLM_STRONG_INPUT_MICROUNITS_PER_MILLION_TOKENS=2000000
# LLM_STRONG_OUTPUT_MICROUNITS_PER_MILLION_TOKENS=8000000
# LLM_STRONG_CACHED_PREFILL_MICROUNITS_PER_MILLION_TOKENS=500000
# LLM_WEAK_INPUT_MICROUNITS_PER_MILLION_TOKENS=500000
# LLM_WEAK_OUTPUT_MICROUNITS_PER_MILLION_TOKENS=2000000
# LLM_WEAK_CACHED_PREFILL_MICROUNITS_PER_MILLION_TOKENS=125000

# ==============================================================
# Retrieval and compression tuning
# ==============================================================
# Fusion weights for the text / graph / audio channels; must sum to 1.
# JSON, not comma-separated: pydantic-settings parses every complex-typed field
# (tuple/list/dict) as JSON, and `0.5,0.3,0.2` raises SettingsError before the
# sum validator ever runs — which took the backend down at `alembic upgrade
# head`, i.e. on the first `docker compose up` after `cp .env.example .env`.
RERANK_CHANNEL_WEIGHTS=[0.5, 0.3, 0.2]
COMPRESSION_DEGREE_THRESHOLD=1
COMPRESSION_AMBIGUOUS_DEPRECATE_DAYS=30
COMPRESSION_FUZZY_TOKEN_RATIO=85

# ==============================================================
# Shared LLM cache (--profile cache-redis)
# ==============================================================
# Empty means no Redis: the gateway falls back to a bounded process-local cache
# with MySQL still the durable source of truth.
REDIS_URL=

# ==============================================================
# Docker Compose only — not read by Settings
# ==============================================================
# These are consumed by docker-compose.yml interpolation (published host ports,
# GPU device selection, bind addresses). The application never sees them.
#
#   COMPOSE_APP_BIND_HOST, COMPOSE_PRIVATE_BIND_HOST
#   MYSQL_HOST_PORT, BACKEND_HOST_PORT, FRONTEND_HOST_PORT, ADMINER_HOST_PORT
#   FUNASR_HOST_PORT, BGE_M3_HOST_PORT, CLAP_HOST_PORT, CAMPPLUS_HOST_PORT
#   VLLM_STRONG_HOST_PORT, VLLM_WEAK_HOST_PORT
#   BGE_M3_CPU_IMAGE, BGE_M3_MAX_CLIENT_BATCH_SIZE, BGE_M3_START_PERIOD
#   BGE_M3_GPU_ID, CLAP_GPU_ID, VLLM_STRONG_GPU_ID, VLLM_WEAK_GPU_ID
#   VLLM_STRONG_GPU_MEMORY_UTILIZATION, VLLM_WEAK_GPU_MEMORY_UTILIZATION
